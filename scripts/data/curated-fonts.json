{
  "schema": 1,
  "description": "Curated typography catalog and fallback metrics for Frontend Skill",
  "archetypes": {
    "modern-saas": {
      "name": "Modern SaaS & Flagship",
      "description": "Ultra-precise neo-grotesque and geometric sans optimized for developer tooling, high-density UI, dashboards, and dark-mode web applications.",
      "defaultHeading": "Plus Jakarta Sans",
      "defaultBody": "Geist",
      "fallbackBase": "Arial"
    },
    "editorial-luxury": {
      "name": "Editorial, Literary & Luxury",
      "description": "High-contrast serifs with warm human rhythm, magazine editorial authority, cultural depth, and elevated typography scales.",
      "defaultHeading": "PP Editorial New",
      "defaultBody": "Charter",
      "fallbackBase": "Georgia"
    },
    "consumer-lifestyle": {
      "name": "Product & Consumer Lifestyle",
      "description": "Approachable geometric curves and humanist geometry tailored for consumer web applications, e-commerce, and onboarding journeys.",
      "defaultHeading": "Circular",
      "defaultBody": "DM Sans",
      "fallbackBase": "Arial"
    },
    "expressive-display": {
      "name": "Creative, Brutalist & Expressive Display",
      "description": "High-impact, asymmetrical, boutique agency, streetwear, and cutting-edge display faces commanding immediate focal attention.",
      "defaultHeading": "Space Grotesk",
      "defaultBody": "Cabinet Grotesk",
      "fallbackBase": "Arial"
    },
    "swiss-authority": {
      "name": "Swiss International & Enterprise Authority",
      "description": "Mid-century modernist clarity, neutral corporate authority, documentation portals, and enterprise-grade data readability.",
      "defaultHeading": "Neue Haas Grotesk",
      "defaultBody": "IBM Plex Sans",
      "fallbackBase": "Arial"
    }
  },
